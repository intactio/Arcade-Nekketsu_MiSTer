CORENAME=JTDODGE
JTFRAME_RATE=57.44
JTFRAME_BUTTONS=2
JTFRAME_CLK24
JTFRAME_PXLCLK=6

# Screen parameters
JTFRAME_COLORW=4
JTFRAME_WIDTH=256
JTFRAME_HEIGHT=240

# ROM regions (byte offsets in the MRA download)
#   maincpu 0x00000  64 kB
#   audiocpu 0x10000 32 kB
#   adpcm   0x18000 2 x 64 kB
#   text    0x38000 256 kB
#   sprites 0x78000 256 kB
#   mcu     0xB8000  16 kB  (PROM BRAM)
#   proms   0xBC000   2 kB  (PROM BRAM)
JTFRAME_BA1_START = 0x10000
PCM_START         = 0x18000
JTFRAME_BA2_START = 0x38000
JTFRAME_BA3_START = 0x78000
JTFRAME_PROM_START= 0xB8000

[mister]
JTFRAME_ARX=4
JTFRAME_ARY=3
